# =============================================================================
# SecureCode-FL Research Repository — .gitignore
# =============================================================================

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
.venv/
.env

# ── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDE / Editor ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS generated ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── LaTeX build artifacts ───────────────────────────────────────────────────
# (Keep .tex, .bib, .bst, .cls source files; ignore everything generated)
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.out
*.toc
*.lof
*.lot
*.log
*.nav
*.snm
*.vrb
*.bcf
*.run.xml
*.idx
*.ind
*.ilg
*.spl
*.xdv
*.dvi
# Compiled PDF from LaTeX (regenerable; keep template PDFs via negation below)
*.pdf
# Preserve the template reference PDFs that ship with sn-article-template
!sn-article-template/sn-article.pdf
!sn-article-template/user-manual.pdf

# ── Trained models & serialised objects (large binaries) ────────────────────
*.pkl
*.joblib
*.h5
*.keras
*.pt
*.pth
*.onnx
*.pb
*.tflite
# Keep model result CSVs (small, human-readable research outputs)
!models/model_results.csv

# ── Large / generated data files ────────────────────────────────────────────
*.npz
# Keep the curated research dataset (small Excel file critical to reproduction)
!data/expanded_dataset.xlsx

# ── VS Code Extension build artifacts ──────────────────────────────────────
vscode-extension/node_modules/
vscode-extension/out/
vscode-extension/*.vsix
vscode-extension/.vscode-test/
**/node_modules/

# ── Cloned third-party repos (tools/repos/) ────────────────────────────────
# These are cloned at scan-time and should NOT bloat the research repo
tools/repos/

# ── BFG Repo-Cleaner (one-off utility jar) ─────────────────────────────────
bfg.jar

# ── Audit / scratch files ──────────────────────────────────────────────────
tracked_files_for_audit*.txt

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Temp / backup files ────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
*.rej
~$*

# ── Figures directory (auto-generated by generate_paper_figures.py) ────────
figures/

# ── Misc binaries & archives ───────────────────────────────────────────────
*.jar
*.zip
*.tar.gz
*.7z
*.rar

# ── Private Paper Files (Springer Nature) ──────────────────────────────────
paper/
sn-*.tex
sn-*.cls
sn-*.bst
